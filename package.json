{
  "name": "frontmatter-timestamps",
  "version": "0.1.1",
  "description": "Obsidian plugin for syncing frontmatter created and updated timestamps.",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production",
    "lint": "eslint .",
    "check": "npm run lint && tsc -noEmit -skipLibCheck"
  },
  "keywords": [
    "obsidian",
    "plugin",
    "frontmatter",
    "timestamps"
  ],
  "author": "Pat",
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "@typescript-eslint/parser": "^8.64.0",
    "esbuild": "^0.28.1",
    "eslint": "^9.39.5",
    "eslint-plugin-obsidianmd": "^0.4.1",
    "obsidian": "^1.5.12",
    "typescript": "^5.4.2"
  }
}
